# BEGIN_KITTY_THEME
# Cherry
include current-theme.conf
# END_KITTY_THEME
#
font_family      Fira Code
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 9.0

remember_window_size  no
initial_window_width  1050
initial_window_height 650

tab_bar_edge top
tab_bar_style powerline

background_opacity 0.95
background_blur 75
